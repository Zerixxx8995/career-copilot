# =============================================================
# Career Copilot — Environment Variables Example
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================

# --- LLM / Embeddings (Google AI Studio) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Vector DB (Qdrant Cloud) ---
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# --- PostgreSQL (Neon or any Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sentry (optional) ---
SENTRY_DSN=

# --- App Settings ---
APP_ENV=development
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# --- JWT / Auth ---
JWT_SECRET=generate-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Embedding Model ---
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# --- Qdrant Collections ---
QDRANT_RESUME_COLLECTION=resume_chunks
QDRANT_JOB_COLLECTION=job_chunks

# --- Agent Settings ---
AGENT_MAX_ITERATIONS=8
LLM_MODEL=gemini-2.0-flash
